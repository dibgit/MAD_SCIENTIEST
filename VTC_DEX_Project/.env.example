# ==============================================================================
# LABORATORY ENVIROMENT VARIABLES BLUEPRINT TEMPLATE FILE
# FILE REGISTRATION PATH: D:\MAD_SCIENTIEST\VTC_DEX_Project\.env
# SECURITY DIRECTIVE: Copy this file, rename it to '.env', and populate keys.
#                     DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# Your unique infrastructure access highway to query live blockchain states
# Obtain via your free developer dashboard panel at Alchemy.com or QuickNode.com
SOLANA_RPC_URL="https://alchemy.com"

# Your dedicated testing sandbox profile public key address string
# Generated inside your isolated browser profile via the Phantom Wallet extension
MY_PUBLIC_WALLET="PASTE_YOUR_PUBLIC_PHANTOM_WALLET_ADDRESS_HERE"

# JUPITER AUTHENTICATION MATRIX ENTRY
JUPITER_API_KEY="PASTE_YOUR_JUPITER_API_KEY"

# STRUCTURAL LADDER CONFIGURATION MATRIX
# Defines the exact number of granular tier steps distributed across your grid limits NUMBER_OF_LADDER > 1
NUMBER_OF_LADDER=257

# PRODUCTION ROTATING LOG ENGINE ARCHITECTURE
# MAX_LOG_SIZE_KB: Threshold size boundary before rotation occurs (10 = 10 Kilobytes)
MAX_LOG_SIZE_KB=10
# MAX_LOG_BACKUPS: Maximum number of backup file layers to retain (10 retains messages0.log through messages9.log)
MAX_LOG_BACKUPS=10

# SYNTHETIC wVTC/SOL CONVEYOR SIMULATION
# Run with: python dex_grid.py --conveyor-sim
CONVEYOR_SIMULATION_EVENTS=30
CONVEYOR_SIMULATION_SEED=42
CONVEYOR_SIMULATION_RUNGS=12
# These are synthetic SOL-per-wVTC prices, not live market quotes.
CONVEYOR_SIMULATION_BUY_FLOOR_SOL=0.000001
CONVEYOR_SIMULATION_BUY_CEILING_SOL=0.00001
CONVEYOR_SIMULATION_INITIAL_SOL=30
CONVEYOR_SIMULATION_INITIAL_WVTC=1200000
CONVEYOR_SIMULATION_SELL_BUCKET_CAP_SOL=3
CONVEYOR_SIMULATION_FEE_RATE=0.006
CONVEYOR_SIMULATION_TARGET_NET_GROWTH=0.0015

# SYNTHETIC USDC/SOL CONVEYOR SIMULATION
# Run with: python dex_grid.py --usdc-sol-sim
# Prices are USDC per SOL; the buy side holds USDC and the sell side holds SOL.
# Each side stays at its rung while that rung has inventory; after exhaustion,
# the next event on that side advances by exactly one rung.
# Buy proceeds go to the paired sell bucket; sell proceeds refill its paired buy bucket.
USDC_SOL_SIMULATION_BUY_FLOOR=100
USDC_SOL_SIMULATION_BUY_CEILING=200
USDC_SOL_SIMULATION_INITIAL_USDC=1500
USDC_SOL_SIMULATION_INITIAL_SOL=15
USDC_SOL_SIMULATION_SELL_BUCKET_CAP_SOL=3